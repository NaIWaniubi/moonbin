// Contract tests for the pe package, built on deterministic in-test PE
// fixtures. The same byte layout is regenerated by test/pe_crosscheck.sh and
// verified there against `objdump -x`, so the constants below are checked by
// an independent parser too.
//
// Golden layout (file size 0x600, FileAlignment 0x200, SectionAlignment 0x1000):
//   0x000 DOS header, e_lfanew = 0x40
//   0x040 "PE\0\0" + COFF (2 sections, timestamp 0x60000000, chars 0x2022)
//   0x058 optional header (240 bytes PE32+ / 224 bytes PE32)
//         entry RVA 0x1000, ImageBase 0x140000000 (PE32+: 0x10000000 PE32)
//         16 data directories: export RVA 0x2000, import RVA 0x2100
//   0x148 section table: .text (VA 0x1000, raw 0x200@0x200, rx)
//                        .rdata (VA 0x2000, raw 0x200@0x400, r)
//   0x200 .text raw (0xC3 then 0xCC fill)
//   0x400 .rdata raw: export dir (1 named export "moonbin_export", ordinal 1,
//         RVA 0x1000, DLL "moonbin_test.dll"), import dir (KERNEL32.dll with
//         LoadLibraryA + GetProcAddress via 8/4-byte thunks)

fn put16(a : Array[Byte], off : Int, v : Int) -> Unit {
  a[off] = (v & 0xFF).to_byte()
  a[off + 1] = ((v >> 8) & 0xFF).to_byte()
}

fn put32(a : Array[Byte], off : Int, v : Int) -> Unit {
  for i = 0; i < 4; i = i + 1 {
    a[off + i] = ((v >> (i * 8)) & 0xFF).to_byte()
  }
}

fn put64(a : Array[Byte], off : Int, v : Int64) -> Unit {
  for i = 0; i < 8; i = i + 1 {
    a[off + i] = ((v >> (i * 8)) & 0xFF).to_int().to_byte()
  }
}

/// Write a NUL-padded 8-byte name field.
fn putname(a : Array[Byte], off : Int, s : String) -> Unit {
  for i = 0; i < 8; i = i + 1 {
    a[off + i] = (if i < s.length() { s[i].to_int() } else { 0 }).to_byte()
  }
}

fn putstr(a : Array[Byte], off : Int, s : String) -> Unit {
  for i = 0; i < s.length(); i = i + 1 {
    a[off + i] = s[i].to_int().to_byte()
  }
}

/// Build the golden PE image; `is64` selects PE32+ vs PE32.
fn build_pe(is64 : Bool) -> Bytes {
  let a : Array[Byte] = Array::make(0x600, (0).to_byte())
  // DOS header
  putstr(a, 0, "MZ")
  put32(a, 0x3C, 0x40)
  // NT signature + COFF header
  putstr(a, 0x40, "PE")
  put16(a, 0x44, if is64 { 0x8664 } else { 0x14C })
  put16(a, 0x46, 2)
  put32(a, 0x48, 0x60000000)
  put16(a, 0x54, if is64 { 240 } else { 224 })
  put16(a, 0x56, 0x2022)
  // Optional header
  let o = 0x58
  put16(a, o, if is64 { 0x20B } else { 0x10B })
  a[o + 2] = (14).to_byte()
  put32(a, o + 4, 0x200) // SizeOfCode
  put32(a, o + 8, 0x200) // SizeOfInitializedData
  put32(a, o + 16, 0x1000) // AddressOfEntryPoint
  put32(a, o + 20, 0x1000) // BaseOfCode
  if is64 {
    put64(a, o + 24, 0x140000000)
  } else {
    put32(a, o + 24, 0x1000) // BaseOfData
    put32(a, o + 28, 0x10000000) // ImageBase
  }
  put32(a, o + 32, 0x1000) // SectionAlignment
  put32(a, o + 36, 0x200) // FileAlignment
  put16(a, o + 40, 6) // MajorOperatingSystemVersion
  put16(a, o + 48, 6) // MajorSubsystemVersion
  put32(a, o + 56, 0x3000) // SizeOfImage
  put32(a, o + 60, 0x200) // SizeOfHeaders
  put16(a, o + 68, 3) // Subsystem: console
  put16(a, o + 70, 0x160) // DllCharacteristics
  if is64 {
    put64(a, o + 72, 0x100000)
    put64(a, o + 80, 0x1000)
    put64(a, o + 88, 0x100000)
    put64(a, o + 96, 0x1000)
    put32(a, o + 108, 16) // NumberOfRvaAndSizes
  } else {
    put32(a, o + 72, 0x100000)
    put32(a, o + 76, 0x1000)
    put32(a, o + 80, 0x100000)
    put32(a, o + 84, 0x1000)
    put32(a, o + 92, 16)
  }
  let d = o + (if is64 { 112 } else { 96 })
  put32(a, d, 0x2000) // export directory RVA
  put32(a, d + 4, 0xA0) // export directory size
  put32(a, d + 8, 0x2100) // import directory RVA
  put32(a, d + 12, 40) // import directory size
  // Section table
  let s = o + (if is64 { 240 } else { 224 })
  putname(a, s, ".text")
  put32(a, s + 8, 0x40) // VirtualSize
  put32(a, s + 12, 0x1000) // VirtualAddress
  put32(a, s + 16, 0x200) // SizeOfRawData
  put32(a, s + 20, 0x200) // PointerToRawData
  put32(a, s + 36, 0x60000020) // CODE | EXECUTE | READ
  putname(a, s + 40, ".rdata")
  put32(a, s + 48, 0x1C0)
  put32(a, s + 52, 0x2000)
  put32(a, s + 56, 0x200)
  put32(a, s + 60, 0x400)
  put32(a, s + 76, 0x40000040) // INITIALIZED_DATA | READ
  // .text raw data
  for i = 0x200; i < 0x400; i = i + 1 {
    a[i] = (0xCC).to_byte()
  }
  a[0x200] = (0xC3).to_byte()
  // .rdata raw data (RVA base 0x2000)
  let rd = 0x400
  // Export directory at rel 0x000
  put32(a, rd + 4, 0x60000000) // TimeDateStamp
  put32(a, rd + 12, 0x2080) // Name RVA
  put32(a, rd + 16, 1) // OrdinalBase
  put32(a, rd + 20, 1) // NumberOfFunctions
  put32(a, rd + 24, 1) // NumberOfNames
  put32(a, rd + 28, 0x2040) // AddressOfFunctions
  put32(a, rd + 32, 0x2050) // AddressOfNames
  put32(a, rd + 36, 0x2060) // AddressOfNameOrdinals
  put32(a, rd + 0x40, 0x1000) // function[0] RVA
  put32(a, rd + 0x50, 0x2090) // name[0] RVA
  put16(a, rd + 0x60, 0) // ordinal index[0]
  putstr(a, rd + 0x80, "moonbin_test.dll")
  putstr(a, rd + 0x90, "moonbin_export")
  // Import directory at rel 0x100 (one descriptor + zero terminator)
  let im = rd + 0x100
  put32(a, im, 0x2140) // OriginalFirstThunk
  put32(a, im + 12, 0x2180) // Name RVA
  put32(a, im + 16, 0x2160) // FirstThunk
  // ILT at rel 0x140, IAT copy at rel 0x160
  let ilt = rd + 0x140
  let iat = rd + 0x160
  if is64 {
    put64(a, ilt, 0x21A0)
    put64(a, ilt + 8, 0x21B0)
    put64(a, iat, 0x21A0)
    put64(a, iat + 8, 0x21B0)
  } else {
    put32(a, ilt, 0x21A0)
    put32(a, ilt + 4, 0x21B0)
    put32(a, iat, 0x21A0)
    put32(a, iat + 4, 0x21B0)
  }
  putstr(a, rd + 0x180, "KERNEL32.dll")
  put16(a, rd + 0x1A0, 0) // hint
  putstr(a, rd + 0x1A2, "LoadLibraryA")
  put16(a, rd + 0x1B0, 0)
  putstr(a, rd + 0x1B2, "GetProcAddress")
  Bytes::from_array(a)
}

/// Golden PE32+ with a COFF symbol table (2 symbols + 1 aux entry), a string
/// table, and a long section name "/21" resolved through it.
fn build_pe_symbols() -> Bytes {
  let base = build_pe(true)
  let a : Array[Byte] = Array::make(0x656, (0).to_byte())
  for i = 0; i < base.length(); i = i + 1 {
    a[i] = base[i]
  }
  put32(a, 0x4C, 0x600) // PointerToSymbolTable
  put32(a, 0x50, 3) // NumberOfSymbols (incl. aux)
  // symbol 0: "main", func, external, section 1
  putname(a, 0x600, "main")
  put32(a, 0x608, 0x1000)
  put16(a, 0x60C, 1)
  put16(a, 0x60E, 0x20)
  a[0x610] = (2).to_byte()
  // symbol 1: "/4" -> string table, static, 1 aux entry
  putname(a, 0x612, "/4")
  put32(a, 0x61A, 0x2000)
  put16(a, 0x61E, 1)
  a[0x622] = (3).to_byte()
  a[0x623] = (1).to_byte()
  // aux entry at 0x624 stays zero
  // string table at 0x636: size 32, "long_symbol_name" @4, ".text_long" @21
  put32(a, 0x636, 32)
  putstr(a, 0x63A, "long_symbol_name")
  putstr(a, 0x64B, ".text_long")
  // section 0 gets the long name "/21"
  putname(a, 0x148, "/21")
  Bytes::from_array(a)
}

fn patch8(b : Bytes, off : Int, v : Int) -> Bytes {
  Bytes::makei(b.length(), fn(i) { if i == off { v.to_byte() } else { b[i] } })
}

fn patch16(b : Bytes, off : Int, v : Int) -> Bytes {
  Bytes::makei(b.length(), fn(i) {
    if i >= off && i < off + 2 {
      ((v >> ((i - off) * 8)) & 0xFF).to_byte()
    } else {
      b[i]
    }
  })
}

fn patch32(b : Bytes, off : Int, v : Int) -> Bytes {
  Bytes::makei(b.length(), fn(i) {
    if i >= off && i < off + 4 {
      ((v >> ((i - off) * 8)) & 0xFF).to_byte()
    } else {
      b[i]
    }
  })
}

fn patch64(b : Bytes, off : Int, v : Int64) -> Bytes {
  Bytes::makei(b.length(), fn(i) {
    if i >= off && i < off + 8 {
      ((v >> ((i - off) * 8)) & 0xFF).to_int().to_byte()
    } else {
      b[i]
    }
  })
}

fn prefix(b : Bytes, n : Int) -> Bytes {
  Bytes::makei(n, fn(i) { b[i] })
}

fn ok_pe(r : Result[@pe.Pe, @core.ParseError]) -> @pe.Pe {
  match r {
    Ok(pe) => pe
    Err(@core.ParseError::Truncated(m)) =>
      abort("expected Ok from parse, got Truncated: " + m)
    Err(@core.ParseError::Invalid(m)) =>
      abort("expected Ok from parse, got Invalid: " + m)
    Err(@core.ParseError::BadMagic(m)) =>
      abort("expected Ok from parse, got BadMagic: " + m)
  }
}

fn err_kind(r : Result[@pe.Pe, @core.ParseError]) -> String {
  match r {
    Ok(_) => "ok"
    Err(@core.ParseError::Truncated(_)) => "truncated"
    Err(@core.ParseError::BadMagic(_)) => "badmagic"
    Err(@core.ParseError::Invalid(_)) => "invalid"
  }
}

test "pe32+ golden headers" {
  let pe = ok_pe(@pe.parse(build_pe(true)))
  assert_eq(pe.machine, 0x8664)
  assert_eq(pe.is64, true)
  assert_eq(pe.entry, 0x1000)
  assert_eq(pe.image_base, 0x140000000)
}

test "pe32+ golden sections" {
  let pe = ok_pe(@pe.parse(build_pe(true)))
  assert_eq(pe.sections.length(), 2)
  assert_eq(pe.sections[0].name, ".text")
  assert_eq(pe.sections[0].flags, "rx")
  assert_eq(pe.sections[0].vaddr, 0x1000)
  assert_eq(pe.sections[0].offset, 0x200)
  assert_eq(pe.sections[0].size, 0x200)
  assert_eq(pe.sections[1].name, ".rdata")
  assert_eq(pe.sections[1].flags, "r")
  assert_eq(pe.sections[1].vaddr, 0x2000)
  assert_eq(pe.sections[1].offset, 0x400)
  assert_eq(pe.sections[1].size, 0x200)
}

test "pe32+ golden imports" {
  let pe = ok_pe(@pe.parse(build_pe(true)))
  assert_eq(pe.imports.length(), 2)
  assert_eq(pe.imports[0].library, "KERNEL32.dll")
  assert_eq(pe.imports[0].name, "LoadLibraryA")
  assert_eq(pe.imports[1].library, "KERNEL32.dll")
  assert_eq(pe.imports[1].name, "GetProcAddress")
}

test "pe32+ golden exports" {
  let pe = ok_pe(@pe.parse(build_pe(true)))
  assert_eq(pe.exports.length(), 1)
  assert_eq(pe.exports[0].name, "moonbin_export")
  assert_eq(pe.exports[0].ordinal, 1)
  assert_eq(pe.exports[0].rva, 0x1000)
}

test "pe32 golden headers and tables" {
  let pe = ok_pe(@pe.parse(build_pe(false)))
  assert_eq(pe.machine, 0x14C)
  assert_eq(pe.is64, false)
  assert_eq(pe.entry, 0x1000)
  assert_eq(pe.image_base, 0x10000000)
  assert_eq(pe.sections.length(), 2)
  assert_eq(pe.sections[0].name, ".text")
  assert_eq(pe.sections[1].name, ".rdata")
  assert_eq(pe.imports.length(), 2)
  assert_eq(pe.imports[0].library, "KERNEL32.dll")
  assert_eq(pe.imports[0].name, "LoadLibraryA")
  assert_eq(pe.imports[1].name, "GetProcAddress")
  assert_eq(pe.exports.length(), 1)
  assert_eq(pe.exports[0].name, "moonbin_export")
  assert_eq(pe.exports[0].ordinal, 1)
  assert_eq(pe.exports[0].rva, 0x1000)
}

test "ordinal import is reported as #ordinal" {
  // Replace ILT entry 1 (file offset 0x548) with ordinal 42.
  let b = patch64(build_pe(true), 0x548, 0x800000000000002A)
  let pe = ok_pe(@pe.parse(b))
  assert_eq(pe.imports.length(), 2)
  assert_eq(pe.imports[0].name, "LoadLibraryA")
  assert_eq(pe.imports[1].library, "KERNEL32.dll")
  assert_eq(pe.imports[1].name, "#42")
}

test "coff symbols, aux skip, long names" {
  let pe = ok_pe(@pe.parse(build_pe_symbols()))
  assert_eq(pe.sections[0].name, ".text_long")
  assert_eq(pe.symbols.length(), 2)
  assert_eq(pe.symbols[0].name, "main")
  assert_eq(pe.symbols[0].value, 0x1000)
  assert_eq(pe.symbols[0].kind, "func")
  assert_eq(pe.symbols[0].bind, "global")
  assert_eq(pe.symbols[0].shndx, 1)
  assert_eq(pe.symbols[1].name, "long_symbol_name")
  assert_eq(pe.symbols[1].value, 0x2000)
  assert_eq(pe.symbols[1].bind, "local")
  assert_eq(pe.symbols[1].shndx, 1)
}

test "empty input refused" {
  assert_eq(err_kind(@pe.parse(Bytes::from_array([]))), "truncated")
}

test "bad dos magic refused" {
  assert_eq(err_kind(@pe.parse(patch8(build_pe(true), 0, 0x58))), "badmagic")
}

test "bad nt signature refused" {
  assert_eq(err_kind(@pe.parse(patch8(build_pe(true), 0x40, 0x58))), "badmagic")
}

test "bad optional header magic refused" {
  assert_eq(err_kind(@pe.parse(patch16(build_pe(true), 0x58, 0x1FF))), "badmagic")
}

test "truncated headers refused" {
  assert_eq(err_kind(@pe.parse(prefix(build_pe(true), 0x100))), "truncated")
}

test "truncated section data refused" {
  assert_eq(err_kind(@pe.parse(prefix(build_pe(true), 0x500))), "truncated")
}

test "elfanew out of range refused" {
  assert_eq(err_kind(@pe.parse(patch32(build_pe(true), 0x3C, 0xFFFF0000))), "invalid")
}

test "unmapped import rva refused" {
  // Data directory 1 RVA lives at 0x58 + 112 + 8 = 0xD0.
  assert_eq(err_kind(@pe.parse(patch32(build_pe(true), 0xD0, 0x0DEAD000))), "invalid")
}

test "section raw data beyond eof refused" {
  // .text SizeOfRawData lives at 0x148 + 16 = 0x158.
  assert_eq(err_kind(@pe.parse(patch32(build_pe(true), 0x158, 0x10000))), "truncated")
}

test "every strict prefix of the golden image is refused" {
  let golden = build_pe(true)
  for i = 0; i < golden.length(); i = i + 1 {
    assert_true(err_kind(@pe.parse(prefix(golden, i))) != "ok")
  }
}

test "single byte mutations never panic" {
  let golden = build_pe(true)
  for off = 0; off < golden.length(); off = off + 1 {
    let mutated = Bytes::makei(golden.length(), fn(i) {
      if i == off {
        (golden[i].to_int() ^ 0xFF).to_byte()
      } else {
        golden[i]
      }
    })
    let _ = @pe.parse(mutated)
  }
}

// ---------------------------------------------------------------------------
// Extended fixture: golden image + a third section ".extra" (VA 0x3000, raw
// 0x400 @ 0x600) carrying base relocations (dir 5), a resource tree (dir 2),
// TLS (dir 9) and delay imports (dir 13). File size 0xA00.
//
//   .extra rel 0x000 RVA 0x3000: reloc block VA 0x1000, size 16:
//       entries (type t, off 0), (t, 8), (0 ABSOLUTE pad, 0x10), (t, 0x18)
//       where t = DIR64(10) for PE32+, HIGHLOW(3) for PE32
//   .extra rel 0x010 RVA 0x3010: reloc block VA 0x2000, size 12: (t, 0x20), (t, 0x28)
//   .extra rel 0x020 RVA 0x3020: resource root: 1 named ("RT_ICON" group,
//       name RVA 0x30A8), 1 id (3); each child -> second level with one id
//       entry (1) -> leaf data entry. Top-level types: [-12456, 3].
//   .extra rel 0x080 RVA 0x3080: TLS directory (PE32+ 40 / PE32 24 bytes),
//       AddressOfCallBacks -> RVA 0x30C0 array [base+0x1000, base+0x1020, 0]
//   .extra rel 0x100 RVA 0x3100: one delay descriptor (attrs 1,
//       "DELAYIMP.dll", INT -> 2 thunks: name "DelayFunc", ordinal 7)
// ---------------------------------------------------------------------------

/// Build the extended fixture; `is64` selects PE32+ vs PE32.
fn build_pe_ext(is64 : Bool) -> Bytes {
  let base = build_pe(is64)
  let a : Array[Byte] = Array::make(0xA00, (0).to_byte())
  for i = 0; i < base.length(); i = i + 1 {
    a[i] = base[i]
  }
  let image_base : Int64 = if is64 { 0x140000000 } else { 0x10000000 }
  put16(a, 0x46, 3) // NumberOfSections
  put32(a, 0x58 + 56, 0x4000) // SizeOfImage
  // third section header right after the two golden ones
  let s3 = 0x58 + (if is64 { 240 } else { 224 }) + 80
  putname(a, s3, ".extra")
  put32(a, s3 + 8, 0x400) // VirtualSize
  put32(a, s3 + 12, 0x3000) // VirtualAddress
  put32(a, s3 + 16, 0x400) // SizeOfRawData
  put32(a, s3 + 20, 0x600) // PointerToRawData
  put32(a, s3 + 36, 0x40000040) // INITIALIZED_DATA | READ
  // data directories 2 (resource), 5 (reloc), 9 (TLS), 13 (delay)
  let d = 0x58 + (if is64 { 112 } else { 96 })
  put32(a, d + 2 * 8, 0x3020)
  put32(a, d + 2 * 8 + 4, 0x60)
  put32(a, d + 5 * 8, 0x3000)
  put32(a, d + 5 * 8 + 4, 0x1C) // 16 + 12 bytes of blocks
  put32(a, d + 9 * 8, 0x3080)
  put32(a, d + 9 * 8 + 4, if is64 { 40 } else { 24 })
  put32(a, d + 13 * 8, 0x3100)
  put32(a, d + 13 * 8 + 4, 64)
  let x = 0x600 // .extra raw base, RVA base 0x3000
  // base relocation blocks
  let t = if is64 { 10 } else { 3 }
  put32(a, x, 0x1000) // block 1 page RVA
  put32(a, x + 4, 16) // block 1 size
  put16(a, x + 8, (t << 12) | 0x000)
  put16(a, x + 10, (t << 12) | 0x008)
  put16(a, x + 12, 0x0010) // ABSOLUTE padding, must be skipped
  put16(a, x + 14, (t << 12) | 0x018)
  put32(a, x + 0x10, 0x2000) // block 2 page RVA
  put32(a, x + 0x14, 12) // block 2 size
  put16(a, x + 0x18, (t << 12) | 0x020)
  put16(a, x + 0x1A, (t << 12) | 0x028)
  // resource tree (root header 16 bytes, then 8-byte entries)
  put16(a, x + 0x2C, 1) // root NumberOfNamedEntries
  put16(a, x + 0x2E, 1) // root NumberOfIdEntries
  put32(a, x + 0x30, 0x800030A8) // named entry: name RVA with high bit set
  put32(a, x + 0x34, 0x80000040) // named entry -> subdir at rel 0x40
  put32(a, x + 0x38, 3) // id entry: RT_ICON
  put32(a, x + 0x3C, 0x80000050) // id entry -> subdir at rel 0x50
  put16(a, x + 0x40, 0) // named subdir: 0 named
  put16(a, x + 0x42, 1) // 1 id
  put32(a, x + 0x44, 1)
  put32(a, x + 0x48, 0x60) // -> leaf data entry at rel 0x60
  put16(a, x + 0x50, 0)
  put16(a, x + 0x52, 1)
  put32(a, x + 0x54, 1)
  put32(a, x + 0x58, 0x70) // -> leaf data entry at rel 0x70
  put32(a, x + 0x60, 0x1000) // leaf 1 Data RVA
  put32(a, x + 0x64, 4) // leaf 1 Size
  put32(a, x + 0x70, 0x1004) // leaf 2 Data RVA
  put32(a, x + 0x74, 4) // leaf 2 Size
  // length-prefixed UTF-16 name "RT_ICON" at rel 0xA8
  put16(a, x + 0xA8, 7)
  let rname = "RT_ICON"
  for i = 0; i < rname.length(); i = i + 1 {
    put16(a, x + 0xAA + 2 * i, rname[i].to_int())
  }
  // TLS directory
  let tls = x + 0x80
  if is64 {
    put64(a, tls, image_base + 0x1800) // StartAddressOfRawData
    put64(a, tls + 8, image_base + 0x1810) // EndAddressOfRawData
    put64(a, tls + 16, image_base + 0x2200) // AddressOfIndex
    put64(a, tls + 24, image_base + 0x30C0) // AddressOfCallBacks
  } else {
    put32(a, tls, (image_base + 0x1800).to_int())
    put32(a, tls + 4, (image_base + 0x1810).to_int())
    put32(a, tls + 8, (image_base + 0x2200).to_int())
    put32(a, tls + 12, (image_base + 0x30C0).to_int())
  }
  // TLS callback array at rel 0xC0 (RVA 0x30C0)
  if is64 {
    put64(a, x + 0xC0, image_base + 0x1000)
    put64(a, x + 0xC8, image_base + 0x1020)
  } else {
    put32(a, x + 0xC0, (image_base + 0x1000).to_int())
    put32(a, x + 0xC4, (image_base + 0x1020).to_int())
  }
  // delay import descriptor at rel 0x100 (RVA 0x3100)
  let dl = x + 0x100
  put32(a, dl, 1) // attrs: dlattrRva
  put32(a, dl + 4, 0x3140) // DLL name RVA
  put32(a, dl + 12, 0x3160) // INT RVA
  put32(a, dl + 16, 0x3180) // IAT RVA
  // INT at rel 0x160, IAT copy at rel 0x180
  let thunk_size = if is64 { 8 } else { 4 }
  let ordinal_flag : Int64 = if is64 { 0x8000000000000000 } else { 0x80000000 }
  if is64 {
    put64(a, x + 0x160, 0x31A0)
    put64(a, x + 0x160 + thunk_size, ordinal_flag | 7)
    put64(a, x + 0x180, 0x31A0)
    put64(a, x + 0x180 + thunk_size, ordinal_flag | 7)
  } else {
    put32(a, x + 0x160, 0x31A0)
    put32(a, x + 0x160 + thunk_size, (ordinal_flag | 7).to_int())
    put32(a, x + 0x180, 0x31A0)
    put32(a, x + 0x180 + thunk_size, (ordinal_flag | 7).to_int())
  }
  putstr(a, x + 0x140, "DELAYIMP.dll")
  put16(a, x + 0x1A0, 0) // hint
  putstr(a, x + 0x1A2, "DelayFunc")
  Bytes::from_array(a)
}

test "pe32+ golden relocations" {
  let pe = ok_pe(@pe.parse(build_pe_ext(true)))
  assert_eq(pe.relocations.length(), 5)
  assert_eq(pe.relocations[0], (0x1000, 10))
  assert_eq(pe.relocations[1], (0x1008, 10))
  assert_eq(pe.relocations[2], (0x1018, 10))
  assert_eq(pe.relocations[3], (0x2020, 10))
  assert_eq(pe.relocations[4], (0x2028, 10))
}

test "pe32 golden relocations" {
  let pe = ok_pe(@pe.parse(build_pe_ext(false)))
  assert_eq(pe.relocations.length(), 5)
  assert_eq(pe.relocations[0], (0x1000, 3))
  assert_eq(pe.relocations[1], (0x1008, 3))
  assert_eq(pe.relocations[2], (0x1018, 3))
  assert_eq(pe.relocations[3], (0x2020, 3))
  assert_eq(pe.relocations[4], (0x2028, 3))
}

test "pe32+ golden delay imports" {
  let pe = ok_pe(@pe.parse(build_pe_ext(true)))
  assert_eq(pe.delay_imports.length(), 2)
  assert_eq(pe.delay_imports[0].library, "DELAYIMP.dll")
  assert_eq(pe.delay_imports[0].name, "DelayFunc")
  assert_eq(pe.delay_imports[1].library, "DELAYIMP.dll")
  assert_eq(pe.delay_imports[1].name, "#7")
}

test "pe32 golden delay imports" {
  let pe = ok_pe(@pe.parse(build_pe_ext(false)))
  assert_eq(pe.delay_imports.length(), 2)
  assert_eq(pe.delay_imports[0].library, "DELAYIMP.dll")
  assert_eq(pe.delay_imports[0].name, "DelayFunc")
  assert_eq(pe.delay_imports[1].name, "#7")
}

test "pe32+ golden tls callbacks" {
  let pe = ok_pe(@pe.parse(build_pe_ext(true)))
  assert_eq(pe.tls_callbacks.length(), 2)
  assert_eq(pe.tls_callbacks[0], 0x140001000)
  assert_eq(pe.tls_callbacks[1], 0x140001020)
}

test "pe32 golden tls callbacks" {
  let pe = ok_pe(@pe.parse(build_pe_ext(false)))
  assert_eq(pe.tls_callbacks.length(), 2)
  assert_eq(pe.tls_callbacks[0], 0x10001000)
  assert_eq(pe.tls_callbacks[1], 0x10001020)
}

test "pe32+ golden resource types" {
  let pe = ok_pe(@pe.parse(build_pe_ext(true)))
  assert_eq(pe.resource_types.length(), 2)
  // named type first: -(name RVA 0x30A8); then numeric id 3 (RT_ICON).
  assert_eq(pe.resource_types[0], -12456)
  assert_eq(pe.resource_types[1], 3)
}

test "pe32 golden resource types" {
  let pe = ok_pe(@pe.parse(build_pe_ext(false)))
  assert_eq(pe.resource_types.length(), 2)
  assert_eq(pe.resource_types[0], -12456)
  assert_eq(pe.resource_types[1], 3)
}

test "extended fixture keeps the base tables intact" {
  let pe = ok_pe(@pe.parse(build_pe_ext(true)))
  assert_eq(pe.imports.length(), 2)
  assert_eq(pe.imports[0].library, "KERNEL32.dll")
  assert_eq(pe.imports[0].name, "LoadLibraryA")
  assert_eq(pe.imports[1].name, "GetProcAddress")
  assert_eq(pe.exports.length(), 1)
  assert_eq(pe.exports[0].name, "moonbin_export")
  assert_eq(pe.sections.length(), 3)
  assert_eq(pe.sections[2].name, ".extra")
}

test "base golden fixture has empty new fields" {
  let pe64 = ok_pe(@pe.parse(build_pe(true)))
  assert_eq(pe64.relocations.length(), 0)
  assert_eq(pe64.delay_imports.length(), 0)
  assert_eq(pe64.tls_callbacks.length(), 0)
  assert_eq(pe64.resource_types.length(), 0)
  let pe32 = ok_pe(@pe.parse(build_pe(false)))
  assert_eq(pe32.relocations.length(), 0)
  assert_eq(pe32.delay_imports.length(), 0)
  assert_eq(pe32.tls_callbacks.length(), 0)
  assert_eq(pe32.resource_types.length(), 0)
}

// Optional directories are best-effort: a corrupt or unmapped optional table
// yields an empty field, never a whole-image refusal (real DLLs routinely have
// optional RVAs that are valid in memory but absent from the raw file).

test "reloc block size below 8 tolerated (best-effort)" {
  let pe = ok_pe(@pe.parse(patch32(build_pe_ext(true), 0x604, 4)))
  assert_eq(pe.relocations.length(), 0)
}

test "reloc block size odd tolerated (best-effort)" {
  let pe = ok_pe(@pe.parse(patch32(build_pe_ext(true), 0x604, 13)))
  assert_eq(pe.relocations.length(), 0)
}

test "reloc block larger than directory tolerated (best-effort)" {
  let pe = ok_pe(@pe.parse(patch32(build_pe_ext(true), 0x604, 0x100)))
  assert_eq(pe.relocations.length(), 0)
}

test "unmapped reloc directory rva tolerated (best-effort)" {
  let pe = ok_pe(@pe.parse(patch32(build_pe_ext(true), 0xF0, 0x0DEAD000)))
  assert_eq(pe.relocations.length(), 0)
}

test "delay descriptor without thunks tolerated (best-effort)" {
  let b = patch32(build_pe_ext(true), 0x70C, 0)
  let b = patch32(b, 0x710, 0)
  let pe = ok_pe(@pe.parse(b))
  assert_eq(pe.delay_imports.length(), 0)
}

test "delay descriptor falls back to IAT when INT is zero" {
  let b = patch32(build_pe_ext(true), 0x70C, 0)
  let pe = ok_pe(@pe.parse(b))
  assert_eq(pe.delay_imports.length(), 2)
  assert_eq(pe.delay_imports[0].name, "DelayFunc")
  assert_eq(pe.delay_imports[1].name, "#7")
}

test "unmapped delay dll name tolerated (best-effort)" {
  let pe = ok_pe(@pe.parse(patch32(build_pe_ext(true), 0x704, 0x0DEAD000)))
  assert_eq(pe.delay_imports.length(), 0)
}

test "unmapped tls callback array tolerated (best-effort)" {
  let pe = ok_pe(@pe.parse(patch64(build_pe_ext(true), 0x698, 0x140000000 + 0x9000)))
  assert_eq(pe.tls_callbacks.length(), 0)
}

test "tls directory smaller than minimum tolerated (best-effort)" {
  let pe = ok_pe(@pe.parse(patch32(build_pe_ext(true), 0x114, 8)))
  assert_eq(pe.tls_callbacks.length(), 0)
}

test "resource entry count beyond file tolerated (best-effort)" {
  let pe = ok_pe(@pe.parse(patch16(build_pe_ext(true), 0x62E, 0x7FFF)))
  assert_eq(pe.resource_types.length(), 0)
}

test "resource child offset out of range tolerated (best-effort)" {
  let pe = ok_pe(@pe.parse(patch32(build_pe_ext(true), 0x634, 0xFFFFFFFF)))
  assert_eq(pe.resource_types.length(), 0)
}

test "every strict prefix of the extended image is refused" {
  let ext = build_pe_ext(true)
  for i = 0; i < ext.length(); i = i + 1 {
    assert_true(err_kind(@pe.parse(prefix(ext, i))) != "ok")
  }
}

test "single byte mutations of the extended image never panic" {
  let ext = build_pe_ext(true)
  for off = 0; off < ext.length(); off = off + 1 {
    let mutated = Bytes::makei(ext.length(), fn(i) {
      if i == off {
        (ext[i].to_int() ^ 0xFF).to_byte()
      } else {
        ext[i]
      }
    })
    let _ = @pe.parse(mutated)
  }
}
